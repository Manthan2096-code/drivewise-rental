    {
      "name": "POST - Create Toyota Corolla",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Create Toyota Corolla\", function () { pm.response.to.have.status(201); var v = pm.response.json(); pm.expect(v.model).to.eql(\"Toyota Corolla\"); pm.expect(v.category).to.eql(\"Car\"); pm.collectionVariables.set(\"vehicleId\", v.id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model\": \"Toyota Corolla\",\n  \"category\": \"Car\",\n  \"transmission\": \"Automatic\",\n  \"seats\": 5,\n  \"pricePerDay\": 2499\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/api/vehicles"
      }
    },

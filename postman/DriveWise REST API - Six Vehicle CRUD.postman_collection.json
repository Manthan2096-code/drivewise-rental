{
  "info": {
    "name": "DriveWise REST API - Six Vehicle CRUD",
    "description": "Runs the CRUD sequence for each of the six vehicles and three categories shown on the DriveWise website. Each created test record is removed at the end of its sequence.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 GET - All Vehicles",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"List vehicles\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/vehicles"
      }
    },
    {
      "name": "2 GET - Single Vehicle",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Get Toyota Corolla\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().model).to.eql(\"Toyota Corolla\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/vehicles/corolla"
      }
    },
    {
      "name": "GET - Filter Car",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Filter by Car\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().length).to.be.above(0); pm.response.json().forEach(function (v) { pm.expect(v.category).to.eql(\"Car\"); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/vehicles?category=Car"
